# Portfolio Admin CMS Environment Variables
# Copy these to Vercel Environment Variables if deploying to Supabase

# Supabase Credentials (Optional: App falls back to local engine if missing)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Default Local Admin Credentials (Optional: Defaults to admin@portfolio.com / admin123)
VITE_ADMIN_EMAIL=admin@portfolio.com
VITE_ADMIN_PASSWORD=admin123
